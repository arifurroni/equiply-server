# Equiply Server - environment variables
# Copy this file to ".env" and fill in the real values.
# NEVER put real secrets in this example file.

# Port the API server listens on
PORT=5000

# Frontend URL allowed by CORS (must match the Next.js dev server)
CLIENT_URL=http://localhost:3000

# MongoDB connection string (real value goes only in .env)
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name
MONGODB_DB_NAME=equiply-db

# MongoDB must run as a replica set (or use Atlas) for safe booking transactions.

# Stripe secret keys belong only in this backend environment.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
